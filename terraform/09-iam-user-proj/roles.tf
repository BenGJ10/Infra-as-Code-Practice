locals {
  roles_policies = {
    readOnly  = ["ReadOnlyAccess"]
    admin     = ["AdministratorAccess"]
    auditor   = ["SecurityAudit"]
    developer = ["AmazonVPCFullAccess", "AmazonS3FullAccess", "AmazonEC2FullAccess"]
  }
}

data "aws_iam_policy_document" "assume_role" {
    statement {
        actions = ["sts:AssumeRole"]
        principals {
            type        = "AWS"
            identifiers = [""]
        }
    }
}


resource "aws_iam_role" "roles" {
  for_each = toset(keys(local.roles_policies))
  name     = each.value
  
  # The assume_role_policy is required for the role to be assumed by other entities.
  # In this case, we are using a data source to generate the policy document that allows the role to be assumed by AWS services or other IAM users. The assume_role_policy is set to the JSON representation of the policy document generated by the data source.
  assume_role_policy = data.aws_iam_policy_document.assume_role.json
}